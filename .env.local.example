# --- Supabase ---
# Project URL and anon key from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of this app, used for OAuth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Arc (Circle) ecosystem ---
# Public values for Arc Testnet. Safe to expose to the client.
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# --- Circle Programmable Wallets (server-side only — keep secret) ---
# From the Circle Console (https://console.circle.com). Used to auto-provision
# a developer-controlled wallet for each user on Arc Testnet.
CIRCLE_API_KEY=TEST_API_KEY:your_key:your_secret
CIRCLE_ENTITY_SECRET=your_64_char_hex_entity_secret
# Created once. Leave blank on first run; the app provisions a wallet set and
# logs the id to set here so all users share one wallet set.
CIRCLE_WALLET_SET_ID=

# --- Platform vault (holds SafeLock principal + bonds) ---
# Minted once via scripts/create-vault.cjs; reuse across restarts. Public ids.
ARC_VAULT_WALLET_ID=
ARC_VAULT_ADDRESS=

# --- Circle round auto-debit cron (Stage 3) ---
# Shared secret that authorizes the scheduled job at /api/cron/circle-rounds,
# which pulls each round's contribution from opted-in members' wallets. Use a
# long random value (>= 16 chars), e.g. `openssl rand -hex 32`. Set the SAME
# value here AND in the app_config table (so the DB-side SECURITY DEFINER RPCs
# accept it), from the Supabase SQL editor:
#   insert into public.app_config(key, value) values ('cron_secret', '<value>')
#   on conflict (key) do update set value = excluded.value, updated_at = now();
# Vercel Cron automatically sends this as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# --- Telegram notifications ---
# The bot DMs members their circle reminders, auto-debit receipts and payout
# alerts. Create a bot with @BotFather to get the token and username.
#   TELEGRAM_BOT_TOKEN      — secret from BotFather (server-side; sends messages).
#   NEXT_PUBLIC_TELEGRAM_BOT_USERNAME — the bot's @name WITHOUT the @ (used to
#                             build the t.me/<bot>?start=<code> link in the UI).
#   TELEGRAM_WEBHOOK_SECRET — a long random value (>= 16 chars) you choose. It
#                             both authenticates Telegram's webhook calls (sent
#                             back in the X-Telegram-Bot-Api-Secret-Token header)
#                             AND gates the DB-side link RPC, so store the SAME
#                             value in app_config too, from the SQL editor:
#   insert into public.app_config(key, value)
#     values ('telegram_webhook_secret', '<value>')
#     on conflict (key) do update set value = excluded.value, updated_at = now();
# Then register the webhook (one-time), substituting your values:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<your-app>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- USYC yield (real, but permissioned) ---
# USYC is Circle's Treasury-backed, yield-bearing token. It has LIVE contracts on
# Arc Testnet (defaults baked into lib/usyc.ts), but minting/redeeming is gated
# behind an allowlist, so yield runs in a clearly-labelled "simulated" mode until
# you enable it. To go live:
#   1. Open a Circle Support ticket to allowlist ARC_VAULT_ADDRESS for USYC
#      (testnet: ~24-48h). Approve the Teller to pull the vault's USDC.
#   2. Approve the Teller to pull the vault's USDC:
#      CONFIRM=yes node scripts/usyc-golive.cjs approve
#   3. Set ARC_USYC_ENABLED=true.
ARC_USYC_ENABLED=false
# Optional overrides — defaults are the documented Arc Testnet addresses, and
# the mint/redeem signatures verified against the deployed Teller (ERC-4626:
# every uint256 is filled with the amount, every address with the vault).
# ARC_USYC_TOKEN_ADDRESS=0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
# ARC_USYC_TELLER_ADDRESS=0x9fdF14c5B14173D74C08Af27AebFf39240dC105A
# ARC_USYC_ENTITLEMENTS_ADDRESS=0xcc205224862c7641930c87679e98999d23c26113
# ARC_USYC_TELLER_MINT_FN=deposit(uint256,address)
# ARC_USYC_TELLER_REDEEM_FN=redeem(uint256,address,address)
