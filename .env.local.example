# --- Supabase ---
# Project URL and anon key from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of this app, used for OAuth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Arc (Circle) ecosystem ---
# Public values for Arc Testnet. Safe to expose to the client.
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# --- Circle Programmable Wallets (server-side only — keep secret) ---
# From the Circle Console (https://console.circle.com). Used to auto-provision
# a developer-controlled wallet for each user on Arc Testnet.
CIRCLE_API_KEY=TEST_API_KEY:your_key:your_secret
CIRCLE_ENTITY_SECRET=your_64_char_hex_entity_secret
# Created once. Leave blank on first run; the app provisions a wallet set and
# logs the id to set here so all users share one wallet set.
CIRCLE_WALLET_SET_ID=

# --- Platform vault (holds SafeLock principal + bonds) ---
# Minted once via scripts/create-vault.cjs; reuse across restarts. Public ids.
ARC_VAULT_WALLET_ID=
ARC_VAULT_ADDRESS=

# --- USYC yield (real, but permissioned) ---
# USYC is Circle's Treasury-backed, yield-bearing token. It has LIVE contracts on
# Arc Testnet (defaults baked into lib/usyc.ts), but minting/redeeming is gated
# behind an allowlist, so yield runs in a clearly-labelled "simulated" mode until
# you enable it. To go live:
#   1. Open a Circle Support ticket to allowlist ARC_VAULT_ADDRESS for USYC
#      (testnet: ~24-48h). Approve the Teller to pull the vault's USDC.
#   2. Confirm the deployed Teller's mint/redeem function signatures and set
#      ARC_USYC_TELLER_MINT_FN / ARC_USYC_TELLER_REDEEM_FN if they differ.
#   3. Set ARC_USYC_ENABLED=true.
ARC_USYC_ENABLED=false
# Optional overrides — defaults are the documented Arc Testnet addresses.
# ARC_USYC_TOKEN_ADDRESS=0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
# ARC_USYC_TELLER_ADDRESS=0x9fdF14c5B14173D74C08Af27AebFf39240dC105A
# ARC_USYC_ENTITLEMENTS_ADDRESS=0xcc205224862c7641930c87679e98999d23c26113
# ARC_USYC_TELLER_MINT_FN=buy(uint256)
# ARC_USYC_TELLER_REDEEM_FN=sell(uint256)
